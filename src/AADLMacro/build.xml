<?xml version="1.0" encoding="Shift_JIS"?>
<project name="AADLMacroEngine" default="create" basedir=".">
	<property name="dist.dir" location="${basedir}/jar" />
	<property name="build.dir" location="${dist.dir}/classes" />
	<property name="src.dir" location="${basedir}/src" />

	<property name="title" value="AADL Macro Engine" />
	<property name="vendor" value="SOARS Project, PieCake,Inc." />
	<property name="main.class" value="ssac.aadl.macro.AADLMacroEngine" />
	
	<!--init property-->
	<target name="init" >
		<property name="dist.short.version" value="2.2.0" />
		<property name="dist.version" value="${dist.short.version}.20210831" />
		<property name="dist.name" value="AADLMacroEngine" />
		<mkdir dir="${dist.dir}" />
	</target>

	<!--build classes-->
	<target name="mkclass" depends="init">
		<!-- create directories -->
		<mkdir dir="${build.dir}" />

		<!-- compile -->
		<javac destdir="${build.dir}" includeantruntime="no" fork="yes" compiler="javac1.8" encoding="UTF8" source="1.8">
			<compilerarg line="-deprecation -g:lines,source" />
			<src path="${src.dir}" />
		</javac>
	</target>

	<!-- create -->
	<target name="create" depends="mkclass">
		<!-- create jar file -->
		<jar destfile="${dist.dir}/${dist.name}.jar" basedir="${build.dir}" >
			<manifest>
				<attribute name="Specification-Title" value="${title}" />
				<attribute name="Specification-Version" value="${dist.version}" />
				<attribute name="Specification-Vendor" value="${vendor}" />
				<attribute name="Implementation-Title" value="${title}" />
				<attribute name="Implementation-Version" value="${dist.version}" />
				<attribute name="Implementation-Vendor" value="${vendor}" />
				<attribute name="Main-Class" value="${main.class}" />
			</manifest>
		</jar>
		
		<!-- create sources zip -->
		<zip destfile="${dist.dir}/${dist.name}-${dist.short.version}-src.zip">
			<fileset dir="${basedir}/" includes="**/src/" />
			<fileset file="${basedir}/build.xml" />
			<fileset file="${basedir}/Changes_ja.txt" />
		</zip>
	</target>

	<!-- clean -->
	<target name="clean" depends="init">
		<delete dir="${build.dir}" />
		<delete>
			<fileset dir="${dist.dir}" includes="*.jar,*-src.zip,*-javadoc.zip"/>
		</delete>
	</target>

</project>
