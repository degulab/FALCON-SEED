<?xml version="1.0" encoding="UTF-8"?>
<project default="javadoc">
<target name="javadoc">
	<property name="dist.name" value="Exalge2-javadoc" />
	<property name="javadoc.dir" location="jar/javadoc" />
	<property name="dist.dir" location="${javadoc.dir}/${dist.name}" />
	<property name="lib.bin.dir" location="lib/bin" />
	<property name="lib.src.dir" location="lib/src" />

	<!-- delete all failes in doc/javadoc directory -->
	<mkdir dir="${dist.dir}" />
	<delete dir="${dist.dir}" includes="**/*" includeEmptyDirs="true" />
	
	<!-- class-paths -->
	<path id="external.libs">
		<fileset dir="${lib.bin.dir}" includes="*.jar" />
	</path>

	<!-- make javadoc -->
	<javadoc destdir="${dist.dir}" author="true"  use="true" version="true"
		nodeprecated="false" nodeprecatedlist="false" noindex="false"
		additionalparam="-encoding UTF-8 -charset UTF-8"
		classpathref="external.libs"
		access="public" source="1.8" nonavbar="false" notree="false" splitindex="true">

		<sourcepath path="java" />
		<sourcepath path="src/BigExalge" />
		<package name="exalge2.*" />
		<package name="redundantalge.*" />
		
		<link href="https://docs.oracle.com/javase/jp/8/docs/api/" />
		<doctitle>交換代数パッケージ</doctitle>
	</javadoc>
</target>
</project>
