	<classpathentry kind="lib" path="lib/bin/jsonic-1.3.10.jar" />
	<classpathentry kind="con" path="org.eclipse.jdt.junit.JUNIT_CONTAINER/3"/>
	<classpathentry kind="output" path="bin/misc"/>
</classpath>
